{
  "name": "data-ingestion",
  "version": "2.0.0",
  "private": true,
  "description": "Extracts structured figures from public PSX financial filings and corporate-action notices.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/run.js",
    "scan": "bash scripts/secret-scan.sh",
    "evaluate": "node dist/evaluate.js",
    "docs": "node dist/financials/docs.js"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
